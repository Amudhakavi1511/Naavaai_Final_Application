# Origin of the deployed Naavaai API. Leave this unset for local development:
# the Vite dev server proxies /api to http://localhost:8000 (see vite.config.ts),
# so `npm run dev` works with no env file at all.
#
# Set it for any deployed build, with no trailing slash:
# VITE_API_BASE_URL=https://naavaai-api.onrender.com
